const response = await fetch(
  "https://www.googleapis.com/youtube/v3/commentThreads?part=snippet",
  {
    method: "POST",
    headers: {
      Authorization: `Bearer ${accessToken}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      snippet: {
        videoId: "YOUR_VIDEO_ID",
        topLevelComment: {
          snippet: {
            textOriginal: "Amazing video!"
          }
        }
      }
    })
  }
);

